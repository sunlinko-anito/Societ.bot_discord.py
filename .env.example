# Discord bot
DISCORD_TOKEN=your-bot-token

# Discord OAuth2 application (Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback

# Signs the session cookie; keep it stable so logins survive restarts
SESSION_SECRET=generate-with-python-secrets-token_hex-32

# Webhook that receives store redemption alerts in the admin channel
ADMIN_WEBHOOK_URL=

# Comma-separated origins allowed to call the API with cookies (e.g. the Societ-web site)
ALLOWED_ORIGINS=

# Web server
HOST=0.0.0.0
PORT=5000
SOCIET_DB=database.db
